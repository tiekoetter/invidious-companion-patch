From cef92acc029be577b65fd0747cc84c87a71462ee Mon Sep 17 00:00:00 2001
From: Fijxu <fijxu@nadeko.net>
Date: Tue, 29 Apr 2025 14:26:34 -0400
Subject: [PATCH] feat: add more encrypted query parameters via the
 configuration

---
 config/config.example.toml                   |  4 ++++
 src/lib/helpers/config.ts                    |  4 ++++
 src/routes/invidious_routes/dashManifest.ts  |  8 ++++----
 src/routes/invidious_routes/latestVersion.ts |  6 ++----
 src/routes/videoPlaybackProxy.ts             | 21 +++++++++++++++-----
 5 files changed, 30 insertions(+), 13 deletions(-)

diff --git a/config/config.example.toml b/config/config.example.toml
index 3c82495..54579df 100644
--- a/config/config.example.toml
+++ b/config/config.example.toml
@@ -24,6 +24,10 @@
 # enable_metrics = false # env variable: SERVER_ENABLE_METRICS
 # max_dash_resolution = 1080
 # disable_logs = false # env variable: SERVER_DISABLE_LOGS
+# # Query parameters to encrypt
+# # pot: potoken
+# # ip: the IP address from where the video was requested
+# encrypted_query_params = ["pot", "ip"]
  
 # [cache]
 # enabled = true # env variable: CACHE_ENABLED
diff --git a/src/lib/helpers/config.ts b/src/lib/helpers/config.ts
index 4839bc1..96b53b1 100644
--- a/src/lib/helpers/config.ts
+++ b/src/lib/helpers/config.ts
@@ -51,6 +51,10 @@ export const ConfigSchema = z.object({
         encrypt_query_params: z.boolean().default(
             Deno.env.get("SERVER_ENCRYPT_QUERY_PARAMS") === "true" || false,
         ),
+        encrypted_query_params: z.array(z.string()).default(
+            Deno.env.get("SERVER_ENCRYPTED_QUERY_PARAMS")?.split(",") ||
+                ["pot", "ip"],
+        ),
         enable_metrics: z.boolean().default(
             Deno.env.get("SERVER_ENABLE_METRICS") === "true" || false,
         ),
diff --git a/src/routes/invidious_routes/dashManifest.ts b/src/routes/invidious_routes/dashManifest.ts
index 2ecaa1a..3ac9401 100644
--- a/src/routes/invidious_routes/dashManifest.ts
+++ b/src/routes/invidious_routes/dashManifest.ts
@@ -10,8 +10,6 @@ import { encryptQuery } from "../../lib/helpers/encryptQuery.ts";
 import { validateVideoId } from "../../lib/helpers/validateVideoId.ts";
 import { TOKEN_MINTER_NOT_READY_MESSAGE } from "../../constants.ts";
 
-const PRIVATE_PARAM_NAMES = ["pot", "ip"];
-
 const dashManifest = new Hono();
 
 dashManifest.get("/:videoId", async (c) => {
@@ -101,14 +99,16 @@ dashManifest.get("/:videoId", async (c) => {
                         config.server.encrypt_query_params
                     ) {
                         const privateParams = [...queryParams].filter(([key]) =>
-                            PRIVATE_PARAM_NAMES.includes(key)
+                            config.server.encrypted_query_params.includes(key)
                         );
                         const encryptedParams = encryptQuery(
                             JSON.stringify(privateParams),
                             config,
                         );
 
-                        for (const param of PRIVATE_PARAM_NAMES) {
+                        for (
+                            const param of config.server.encrypted_query_params
+                        ) {
                             queryParams.delete(param);
                         }
 
diff --git a/src/routes/invidious_routes/latestVersion.ts b/src/routes/invidious_routes/latestVersion.ts
index 040887e..9101ae4 100644
--- a/src/routes/invidious_routes/latestVersion.ts
+++ b/src/routes/invidious_routes/latestVersion.ts
@@ -9,8 +9,6 @@ import { encryptQuery } from "../../lib/helpers/encryptQuery.ts";
 import { validateVideoId } from "../../lib/helpers/validateVideoId.ts";
 import { TOKEN_MINTER_NOT_READY_MESSAGE } from "../../constants.ts";
 
-const PRIVATE_PARAM_NAMES = ["pot", "ip"];
-
 const latestVersion = new Hono();
 
 latestVersion.get("/", async (c) => {
@@ -96,14 +94,14 @@ latestVersion.get("/", async (c) => {
             queryParams.set("host", itagUrlParsed.host);
             if (config.server.encrypt_query_params) {
                 const privateParams = [...queryParams].filter(([key]) =>
-                    PRIVATE_PARAM_NAMES.includes(key)
+                    config.server.encrypted_query_params.includes(key)
                 );
                 const encryptedParams = encryptQuery(
                     JSON.stringify(privateParams),
                     config,
                 );
 
-                for (const param of PRIVATE_PARAM_NAMES) {
+                for (const param of config.server.encrypted_query_params) {
                     queryParams.delete(param);
                 }
 
diff --git a/src/routes/videoPlaybackProxy.ts b/src/routes/videoPlaybackProxy.ts
index 0126404..7008177 100644
--- a/src/routes/videoPlaybackProxy.ts
+++ b/src/routes/videoPlaybackProxy.ts
@@ -39,13 +39,24 @@ videoPlaybackProxy.get("/", async (c) => {
     if (c.req.query("enc") === "true") {
         const { data: encryptedQuery } = c.req.query();
         const decryptedQueryParams = decryptQuery(encryptedQuery, config);
-        const parsedDecryptedQueryParams = new URLSearchParams(
-            JSON.parse(decryptedQueryParams),
-        );
+        let parsedDecryptedQueryParams: URLSearchParams;
+        try {
+            parsedDecryptedQueryParams = new URLSearchParams(
+                JSON.parse(decryptedQueryParams),
+            );
+        } catch {
+            throw new HTTPException(400, {
+                res: new Response("Invalid encrypted playback URL."),
+            });
+        }
         queryParams.delete("enc");
         queryParams.delete("data");
-        queryParams.set("pot", parsedDecryptedQueryParams.get("pot") as string);
-        queryParams.set("ip", parsedDecryptedQueryParams.get("ip") as string);
+        for (const query of config.server.encrypted_query_params) {
+            const value = parsedDecryptedQueryParams.get(query);
+            if (value !== null) {
+                queryParams.set(query, value);
+            }
+        }
     }
 
     if (host == undefined || !/[\w-]+.googlevideo.com/.test(host)) {
-- 
2.55.0
