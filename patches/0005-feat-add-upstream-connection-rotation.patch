+    const clients: { closed: boolean }[] = [];
+    const usedClients: Deno.HttpClient[] = [];
+    try {
+        Deno.createHttpClient = () => {
+            const state = { closed: false };
+            clients.push(state);
+            return {
+                close() {
+                    state.closed = true;
+                },
+            } as Deno.HttpClient;
+        };
+        globalThis.fetch = (_input, init) => {
+            usedClients.push((init as { client: Deno.HttpClient }).client);
+            return Promise.resolve(
+                new Response(null, {
+                    status: usedClients.length === 1 ? 403 : 200,
+                }),
+            );
+        };
+        const fetchClient = getFetchClient(config);
+        assertEquals(
