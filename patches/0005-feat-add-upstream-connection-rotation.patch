+import { assertEquals, assertRejects } from "./deps.ts";
+import { Hono } from "hono";
+import type { HonoVariables } from "../lib/types/HonoVariables.ts";
+import { ConfigSchema } from "../lib/helpers/config.ts";
+import { getFetchClient } from "../lib/helpers/getFetchClient.ts";
+import videoPlaybackProxy from "../routes/videoPlaybackProxy.ts";
+
+function recoveryConfig(attempts = 2, timeout = 10_000) {
+    return ConfigSchema.parse({
+        server: { secret_key: "testSecretKey123" },
+        networking: {
+            connection_recovery_attempts: attempts,
+            connection_recovery_timeout_ms: timeout,
+        },
+    });
+}
+
+type ClientState = { client: Deno.HttpClient; closes: number };
+
+async function withNetworkMock(
+    fetchImpl: typeof fetch,
+    run: (clients: ClientState[]) => Promise<void>,
+) {
+    const originalFetch = globalThis.fetch;
+    const originalCreateClient = Deno.createHttpClient;
+    const clients: ClientState[] = [];
+    try {
+        Deno.createHttpClient = () => {
+            const state: ClientState = {
+                client: {
+                    close() {
+                        state.closes++;
+                    },
+                } as Deno.HttpClient,
+                closes: 0,
+            };
+            clients.push(state);
+            return state.client;
+        };
+        globalThis.fetch = fetchImpl;
+        await run(clients);
+    } finally {
+        globalThis.fetch = originalFetch;
+        Deno.createHttpClient = originalCreateClient;
+    }
