+Deno.test("playback cancellation aborts pending recovery and closes its pool", async () => {
+    const started = Promise.withResolvers<void>();
+    let signal: AbortSignal | undefined;
+    await withNetworkMock((_input, init) => {
+        if (init?.method === "HEAD") {
+            return Promise.resolve(
+                new Response(null, {
+                    headers: { "content-length": "4" },
+                }),
+            );
+        }
+        signal = init!.signal!;
+        started.resolve();
+        return new Promise((_resolve, reject) => {
+            signal!.addEventListener("abort", () => reject(signal!.reason), {
+                once: true,
+            });
+        });
+    }, async (clients) => {
+        const response = await requestPlayback();
+        const reader = response.body!.getReader();
+        const pending = reader.read();
+        await started.promise;
+        await reader.cancel();
+        assertEquals((await pending).done, true);
+        assertEquals(signal!.aborted, true);
+        assertEquals(clients.every((client) => client.closes === 1), true);
+    });
+});
