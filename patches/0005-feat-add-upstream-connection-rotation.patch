+import { assertEquals, assertRejects } from "./deps.ts";
+import type { ApiResponse, Innertube } from "youtubei.js";
+import { Hono } from "hono";
+import type { HonoVariables } from "../lib/types/HonoVariables.ts";
+import { ConfigSchema } from "../lib/helpers/config.ts";
+import {
+    getFetchClient,
+    UpstreamPoolRotationError,
+} from "../lib/helpers/getFetchClient.ts";
+import player from "../routes/youtube_api_routes/player.ts";
+import latestVersion from "../routes/invidious_routes/latestVersion.ts";
+import dashManifest from "../routes/invidious_routes/dashManifest.ts";
+import captions from "../routes/invidious_routes/captions.ts";
+import {
+    isTemporaryPlayerFailure,
+    type YoutubeSession,
+    YoutubeSessionRecovery,
+} from "../lib/helpers/youtubeSessionRecovery.ts";
+
+function session(name: string): YoutubeSession {
+    return { innertubeClient: { name } as unknown as Innertube };
+}
+
+function playerResponse(
+    reason = "This content isn't available, try again later.",
+    status = "ERROR",
+): ApiResponse {
+    return {
+        success: true,
+        status_code: 200,
+        data: { playabilityStatus: { status, reason } },
+    };
+}
+
+Deno.test("temporary player failure detection excludes genuine availability errors", () => {
+    assertEquals(isTemporaryPlayerFailure(playerResponse()), true);
+    assertEquals(
+        isTemporaryPlayerFailure(
+            playerResponse(
+                "This content isn\u2019t available, try again later.",
+                "UNPLAYABLE",
+            ),
+        ),
+        true,
+    );
+    for (
+        const reason of [
+            "This video is private",
+            "Video unavailable",
+            "This video has been removed",
+            "Not available in your country",
+        ]
+    ) {
+        assertEquals(isTemporaryPlayerFailure(playerResponse(reason)), false);
+    }
+    assertEquals(
+        isTemporaryPlayerFailure(playerResponse(undefined, "LOGIN_REQUIRED")),
+        false,
+    );
+});
+
+Deno.test("temporary player failure detection reads renderer text runs", () => {
+    const response = playerResponse();
+    response.data.playabilityStatus = {
+        status: "ERROR",
+        errorScreen: {
+            playerErrorMessageRenderer: {
+                subreason: {
+                    runs: [{ text: "This content isn't available, " }, {
+                        text: "try again later.",
+                    }],
+                },
+            },
+        },
+    };
+    assertEquals(isTemporaryPlayerFailure(response), true);
+    response.data.playabilityStatus = {
+        status: "ERROR",
+        reason: "This content isn't available.",
+        errorScreen: {
+            playerErrorMessageRenderer: {
+                subreason: { simpleText: "Try again later." },
+            },
+        },
+    };
+    assertEquals(isTemporaryPlayerFailure(response), true);
+});
+
+Deno.test("player recovery rotates the failing API pool and retries the new session", async () => {
+    const previous = session("old");
+    const replacement = session("new");
+    let rotations = 0;
+    let retirements = 0;
+    previous.rotate = () => rotations++;
+    previous.retire = () => retirements++;
+    const recovery = new YoutubeSessionRecovery(
+        previous,
+        () => Promise.resolve(replacement),
+        { attempts: 2, timeoutMs: 1000 },
+    );
+    const seen: YoutubeSession[] = [];
+    const response = await recovery.player((active) => {
+        seen.push(active);
+        return Promise.resolve(
+            active === previous ? playerResponse() : playerResponse("", "OK"),
+        );
+    });
