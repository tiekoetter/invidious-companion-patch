+        assertEquals(
+            (await fetchClient("https://example.com", { method: "HEAD" }))
+                .status,
+            200,
+        );
+        assertEquals(clients.length, 2);
+        assertEquals(clients[0].closed, true);
+        assertEquals(clients[1].closed, false);
+        assertEquals(usedClients[1], usedClients[2]);
+    } finally {
+        globalThis.fetch = originalFetch;
+        Deno.createHttpClient = originalCreateClient;
+    }
