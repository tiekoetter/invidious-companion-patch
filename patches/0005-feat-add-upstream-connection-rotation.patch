+export const getFetchClient = (config: Config): RotatingFetchClient => {
+    const fetchClient = createFetchClient(config);
+    const maxRetries = config.networking.connection_recovery_attempts;
+
+    return Object.assign(async (
+        input: FetchInputParameter,
+        init?: FetchInitParameterWithClient,
