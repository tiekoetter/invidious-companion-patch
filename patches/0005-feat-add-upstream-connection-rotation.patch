new file mode 100644
index 0000000..cc41efe
--- /dev/null
+++ b/src/lib/helpers/youtubeSessionRecovery.ts
@@ -0,0 +1,198 @@
+import { abortable } from "@std/async";
+import type { ApiResponse, Innertube } from "youtubei.js";
+import { z } from "zod";
+import type { TokenMinter } from "../jobs/potoken.ts";
+import { UpstreamPoolRotationError } from "./getFetchClient.ts";
+
+export type YoutubeSession = {
+    innertubeClient: Innertube;
+    tokenMinter?: TokenMinter;
+    rotate?: () => void;
+    retire?: () => void;
+};
+
+const TextSchema = z.object({
+    simpleText: z.string().optional(),
+    runs: z.array(z.object({ text: z.string() })).optional(),
+});
+
+const PlayabilitySchema = z.object({
+    status: z.enum(["ERROR", "UNPLAYABLE"]),
+    reason: z.string().optional(),
+    errorScreen: z.object({
+        playerErrorMessageRenderer: z.object({
+            reason: TextSchema.optional(),
+            subreason: TextSchema.optional(),
+        }),
+    }).optional(),
+});
+
+const REFRESHING_MESSAGE =
+    "Companion is refreshing its YouTube connection. Please try again shortly.";
+const FAILED_MESSAGE =
+    "Companion could not restore its YouTube connection. Please try again shortly.";
+
+export function sessionRecoveryMessage(data: unknown): string | undefined {
+    const parsed = z.object({
+        playabilityStatus: z.object({
+            status: z.literal("ERROR"),
+            reason: z.enum([REFRESHING_MESSAGE, FAILED_MESSAGE]),
+        }),
+    }).safeParse(data);
+    return parsed.success ? parsed.data.playabilityStatus.reason : undefined;
+}
+
+export function isTemporaryPlayerFailure(response: ApiResponse): boolean {
+    const parsed = PlayabilitySchema.safeParse(
+        response.data?.playabilityStatus,
+    );
+    if (!parsed.success) return false;
+    const renderer = parsed.data.errorScreen?.playerErrorMessageRenderer;
+    const text = (value: z.infer<typeof TextSchema> | undefined) =>
+        value?.simpleText ?? value?.runs?.map((run) => run.text).join("");
+    const reason = parsed.data.reason ?? text(renderer?.reason);
+    const subreason = text(renderer?.subreason);
+    return [
+        reason,
+        text(renderer?.reason),
+        subreason,
+        [reason, subreason].filter(Boolean).join(" "),
+    ]
+        .some((value) =>
+            typeof value === "string" &&
+            /^this content (?:isn't|is not) available[,!.]? try again later[.!]?$/
+                .test(
+                    value.replace(/\u2019/g, "'").replace(/\s+/g, " ").trim()
+                        .toLowerCase(),
+                )
+        );
+}
+
+export class YoutubeSessionRecovery {
+    #current: YoutubeSession;
+    #refreshing: Promise<YoutubeSession> | undefined;
+    #lastRecoveryAt = -Infinity;
+
+    constructor(
+        initial: YoutubeSession,
+        private readonly createSession: () => Promise<YoutubeSession>,
+        private readonly options: { attempts: number; timeoutMs: number },
+    ) {
+        this.#current = initial;
+    }
+
+    get current(): YoutubeSession {
+        return this.#current;
+    }
+
+    get isRefreshing(): boolean {
+        return this.#refreshing !== undefined;
+    }
+
+    refresh(failedClient?: Innertube): Promise<YoutubeSession> {
+        if (this.#refreshing) return this.#refreshing;
+        if (failedClient && failedClient !== this.#current.innertubeClient) {
+            return Promise.resolve(this.#current);
+        }
+        if (failedClient) {
+            if (Date.now() - this.#lastRecoveryAt < this.options.timeoutMs) {
+                return Promise.reject(
+                    new Error("Session recovery is cooling down"),
+                );
+            }
+            this.#lastRecoveryAt = Date.now();
+        }
+        const previous = this.#current;
+        this.#refreshing = Promise.resolve().then(() => {
+            if (failedClient) {
+                previous.rotate?.();
+                console.warn(
+                    "[WARN] Refreshing YouTube session after a temporary player failure",
+                );
+            }
+            return this.createSession();
+        })
+            .then((session) => {
+                this.#current = session;
+                previous.retire?.();
+                return session;
+            }).finally(() => {
+                this.#refreshing = undefined;
+            });
+        return this.#refreshing;
+    }
+
+    async player(
+        request: (session: YoutubeSession) => Promise<ApiResponse>,
+        callerSignal?: AbortSignal,
+    ): Promise<ApiResponse> {
+        callerSignal?.throwIfAborted();
+        if (!this.options.attempts) return await request(this.#current);
+
+        let recoverySignal: AbortSignal | undefined;
+        const wait = <Result>(promise: Promise<Result>) => {
+            recoverySignal ??= AbortSignal.any([
+                AbortSignal.timeout(this.options.timeoutMs),
+                ...(callerSignal ? [callerSignal] : []),
+            ]);
+            return abortable(promise, recoverySignal);
+        };
+        let session = this.#current;
+        let response: ApiResponse | undefined;
+        if (this.#refreshing) {
+            try {
+                session = await wait(this.#refreshing);
+                response = await wait(request(session));
+            } catch {
+                callerSignal?.throwIfAborted();
+                return this.unavailable();
+            }
+        } else {
+            try {
+                const pending = request(session);
+                response = callerSignal
+                    ? await abortable(pending, callerSignal)
+                    : await pending;
+            } catch (err) {
+                callerSignal?.throwIfAborted();
+                if (!(err instanceof UpstreamPoolRotationError)) throw err;
+            }
+        }
+        if (response && !isTemporaryPlayerFailure(response)) return response;
+
+        try {
+            for (let attempt = 0; attempt < this.options.attempts; attempt++) {
+                callerSignal?.throwIfAborted();
+                recoverySignal?.throwIfAborted();
