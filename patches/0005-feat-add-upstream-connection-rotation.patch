+            return Promise.resolve(
+                new Response(null, {
+                    headers: { "content-length": "4" },
+                }),
+            );
+        }
+        ranges.push(new URL(String(input)).searchParams.get("range")!);
+        return Promise.resolve(
+            new Response(
+                ranges.length === 1
+                    ? new Uint8Array([1, 2])
+                    : new Uint8Array([3, 4]),
+            ),
+        );
+    }, async (clients) => {
