+import { assertEquals, assertRejects } from "./deps.ts";
+import { Hono } from "hono";
+import type { HonoVariables } from "../lib/types/HonoVariables.ts";
+import { ConfigSchema } from "../lib/helpers/config.ts";
+import {
+    getFetchClient,
+    UpstreamPoolRotationError,
+} from "../lib/helpers/getFetchClient.ts";
+import videoPlaybackProxy from "../routes/videoPlaybackProxy.ts";
+
+function recoveryConfig(attempts = 2, timeout = 10_000) {
+    return ConfigSchema.parse({
+        server: { secret_key: "testSecretKey123" },
+        networking: {
+            connection_recovery_attempts: attempts,
+            connection_recovery_timeout_ms: timeout,
+        },
+    });
+}
+
+type ClientState = { client: Deno.HttpClient; closes: number };
+
+async function withNetworkMock(
+    fetchImpl: typeof fetch,
+    run: (clients: ClientState[]) => Promise<void>,
+) {
+    const originalFetch = globalThis.fetch;
+    const originalCreateClient = Deno.createHttpClient;
+    const clients: ClientState[] = [];
+    try {
+        Deno.createHttpClient = () => {
+            const state: ClientState = {
+                client: {
+                    close() {
+                        state.closes++;
+                    },
+                } as Deno.HttpClient,
+                closes: 0,
+            };
+            clients.push(state);
+            return state.client;
+        };
+        globalThis.fetch = fetchImpl;
+        await run(clients);
+    } finally {
+        globalThis.fetch = originalFetch;
+        Deno.createHttpClient = originalCreateClient;
+    }
+}
+
+function requestPlayback(config = recoveryConfig(), init?: RequestInit) {
+    const app = new Hono<{ Variables: HonoVariables }>();
+    app.use("*", async (context, next) => {
+        context.set("config", config);
+        await next();
+    });
+    app.route("/", videoPlaybackProxy);
+    return app.request(
+        "http://localhost/?host=rr1.googlevideo.com&c=WEB&expire=9999999999",
+        init,
+    );
+}
+
+Deno.test("connection recovery replaces a 403 pool and reuses a healthy pool", async () => {
+    const config = ConfigSchema.parse({
+        server: { secret_key: "testSecretKey123" },
+        networking: { connection_recovery_attempts: 2 },
+    });
+    const originalFetch = globalThis.fetch;
+    const originalCreateClient = Deno.createHttpClient;
+    const clients: { closed: boolean }[] = [];
+    const usedClients: Deno.HttpClient[] = [];
+    try {
+        Deno.createHttpClient = () => {
+            const state = { closed: false };
+            clients.push(state);
+            return {
+                close() {
+                    state.closed = true;
+                },
+            } as Deno.HttpClient;
+        };
+        globalThis.fetch = (_input, init) => {
+            usedClients.push((init as { client: Deno.HttpClient }).client);
+            return Promise.resolve(
+                new Response(null, {
+                    status: usedClients.length === 1 ? 403 : 200,
+                }),
+            );
+        };
+        const fetchClient = getFetchClient(config);
+        assertEquals(
+            (await fetchClient("https://example.com", { method: "HEAD" }))
+                .status,
+            200,
+        );
+        assertEquals(
+            (await fetchClient("https://example.com", { method: "HEAD" }))
+                .status,
+            200,
+        );
+        assertEquals(clients.length, 2);
+        assertEquals(clients[0].closed, true);
+        assertEquals(clients[1].closed, false);
+        assertEquals(usedClients[1], usedClients[2]);
+    } finally {
+        globalThis.fetch = originalFetch;
+        Deno.createHttpClient = originalCreateClient;
+    }
+});
+
+Deno.test("connection recovery is disabled by default", async () => {
+    let calls = 0;
+    await withNetworkMock(() => {
+        calls++;
+        return Promise.resolve(new Response(null, { status: 403 }));
+    }, async (clients) => {
+        const fetchClient = getFetchClient(recoveryConfig(0));
+        assertEquals((await fetchClient("https://example.com")).status, 403);
+        assertEquals(calls, 1);
+        assertEquals(clients.length, 0);
+    });
+});
+
+Deno.test("connection recovery stops at the retry limit", async () => {
+    let calls = 0;
+    await withNetworkMock(() => {
+        calls++;
+        return Promise.resolve(new Response(null, { status: 403 }));
+    }, async (clients) => {
+        const fetchClient = getFetchClient(recoveryConfig());
+        assertEquals((await fetchClient("https://example.com")).status, 403);
+        assertEquals(calls, 3);
+        fetchClient.close();
+        assertEquals(clients.every((client) => client.closes === 1), true);
+    });
+});
+
+Deno.test("connection recovery respects its deadline", async () => {
+    let calls = 0;
+    await withNetworkMock((_input, init) => {
+        if (++calls === 1) {
+            return Promise.resolve(new Response(null, { status: 403 }));
+        }
+        return new Promise((_resolve, reject) => {
+            init!.signal!.addEventListener("abort", () => {
+                reject(init!.signal!.reason);
+            }, { once: true });
+        });
+    }, async () => {
+        const fetchClient = getFetchClient(recoveryConfig(2, 5));
+        await assertRejects(
+            () => fetchClient("https://example.com"),
+            DOMException,
+        );
+        fetchClient.close();
+        assertEquals(calls, 2);
+    });
+});
