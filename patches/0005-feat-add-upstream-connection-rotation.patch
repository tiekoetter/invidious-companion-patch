+Deno.test("connection rotation drains old responses but forced rotation aborts them", async () => {
+    const originalNow = Date.now;
+    let now = 0;
+    const signals: AbortSignal[] = [];
+    await withNetworkMock((_input, init) => {
+        signals.push(init!.signal!);
+        return Promise.resolve(new Response(new Uint8Array([1])));
+    }, async (clients) => {
+        try {
+            Date.now = () => now;
+            const config = recoveryConfig();
+            config.networking.connection_rotation_ms = 10;
+            const fetchClient = getFetchClient(config);
+            const first = await fetchClient("https://example.com");
+            now = 11;
+            const second = await fetchClient("https://example.com");
+            assertEquals(clients[0].closes, 0);
+            assertEquals(signals[0].aborted, false);
+            await first.body!.cancel();
+            assertEquals(clients[0].closes, 1);
+            fetchClient.rotate();
+            assertEquals(signals[1].aborted, true);
+            assertEquals(clients[1].closes, 1);
+            await second.body!.cancel();
+            assertEquals(clients[1].closes, 1);
+            fetchClient.close();
+        } finally {
+            Date.now = originalNow;
+        }
+    });
+});
