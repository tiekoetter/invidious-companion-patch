 src/lib/helpers/youtubePlayerReq.ts      |  2 +-
 src/routes/videoPlaybackProxy.ts         |  7 ++--
 src/tests/connectionRotation_test.ts     | 37 +++++++++++++++++++
 src/tests/youtubeSessionRecovery_test.ts | 47 ++++++++++++++++++++++++
 5 files changed, 91 insertions(+), 4 deletions(-)

diff --git a/config/config.example.toml b/config/config.example.toml
