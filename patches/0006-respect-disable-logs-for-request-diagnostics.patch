diff --git a/src/tests/connectionRotation_test.ts b/src/tests/connectionRotation_test.ts
index 1e59b52..fb7e007 100644
--- a/src/tests/connectionRotation_test.ts
+++ b/src/tests/connectionRotation_test.ts
@@ -549,6 +549,43 @@ Deno.test("playback reports exhausted pre-header connection failures as 502", as
     });
 });
 
+Deno.test("disable_logs silences upstream playback errors", async () => {
+    const originalError = console.error;
+    const logged: unknown[] = [];
+    console.error = (message) => logged.push(message);
+    try {
+        for (const failingMethod of ["HEAD", "POST"]) {
+            for (const disableLogs of [false, true]) {
+                await withNetworkMock((_input, init) => {
+                    if (init?.method === failingMethod) {
+                        return Promise.resolve(
+                            new Response(null, { status: 404 }),
+                        );
+                    }
+                    return Promise.resolve(
+                        new Response(null, {
+                            headers: { "content-length": "4" },
+                        }),
+                    );
+                }, async () => {
+                    const config = recoveryConfig(0);
+                    config.server.disable_logs = disableLogs;
+                    const response = await requestPlayback(config);
+                    assertEquals(
+                        response.status,
+                        failingMethod === "HEAD" ? 404 : 502,
+                    );
+                    await response.body?.cancel();
+                });
+            }
+        }
+    } finally {
+        console.error = originalError;
+    }
+    // A HEAD status is relayed without a message, so only the POST logs.
+    assertEquals(logged, ["[ERROR] googlevideo POST request failed:"]);
+});
+
 Deno.test("playback rejects mismatched ranges without forwarding corrupt data", async () => {
