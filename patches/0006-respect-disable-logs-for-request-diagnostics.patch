diff --git a/src/tests/youtubeSessionRecovery_test.ts b/src/tests/youtubeSessionRecovery_test.ts
index 90cf7d5..539b6dc 100644
--- a/src/tests/youtubeSessionRecovery_test.ts
+++ b/src/tests/youtubeSessionRecovery_test.ts
@@ -256,6 +256,53 @@ Deno.test("player request marks empty formats as retryable but preserves unavail
     );
 });
 
+Deno.test("disable_logs silences the fallback warning that names the video", async () => {
+    const noFormats = (): ApiResponse => ({
+        success: true,
+        status_code: 200,
+        data: {
+            playabilityStatus: { status: "OK" },
+            streamingData: {
+                expiresInSeconds: "21540",
+                adaptiveFormats: [{ itag: 18 }],
+                formats: [],
+            },
+        },
+    });
+    const originalWarn = console.warn;
+    const warnings: unknown[] = [];
+    console.warn = (message) => warnings.push(message);
+    try {
+        for (const disableLogs of [false, true]) {
+            await assertRejects(
+                () =>
+                    youtubePlayerReq(
+                        {
+                            session: { player: { signature_timestamp: 1 } },
+                            actions: {
+                                execute: () => Promise.resolve(noFormats()),
+                            },
+                        } as unknown as Innertube,
+                        "abcdefghijk",
+                        ConfigSchema.parse({
+                            server: {
+                                secret_key: "testSecretKey123",
+                                disable_logs: disableLogs,
+                            },
+                        }),
+                        () => Promise.resolve("content-token"),
+                    ),
+                RetryableYoutubeSessionError,
+            );
+        }
+    } finally {
+        console.warn = originalWarn;
+    }
+    assertEquals(warnings, [
+        "[WARNING] No fallback YT client supplied usable adaptive formats for video: abcdefghijk",
+    ]);
+});
+
